+//! `crow-server`: remote execution node of CrowBrowser. Keeps no logs of addresses or pages.
+
+mod eco;
+mod policy;
+mod ram;
+mod rbi;
+mod tunnel;
+
+use crow_proto::{Open, Reply, Rx, Tx, accept, derive_psk, parse_token};
+use mimalloc::MiMalloc;
+use std::{
+    alloc::{GlobalAlloc, Layout},
+    path::PathBuf,
+    sync::Arc,
+    time::Duration,
+};
+use tokio::{
+    net::{TcpListener, TcpStream},
+    sync::Semaphore,
+};
+use zeroize::{Zeroize, Zeroizing};
+
+/// Every heap block is overwritten when freed, whichever library owned it: pages, DOM trees,
+/// TLS and socket buffers of a session do not outlive it in RAM.
+struct WipingAlloc;
+
+// SAFETY: forwards to mimalloc with the caller's layout; `dealloc` only writes inside the block
+// it is about to free.
+unsafe impl GlobalAlloc for WipingAlloc {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        unsafe { MiMalloc.alloc(layout) }
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        unsafe { MiMalloc.alloc_zeroed(layout) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        unsafe {
+            std::slice::from_raw_parts_mut(ptr, layout.size()).zeroize();
+            MiMalloc.dealloc(ptr, layout);
+        }
+    }
+}
+
+#[global_allocator]
+static GLOBAL: WipingAlloc = WipingAlloc;
+
+const MAX_CONNECTIONS: usize = 2048;
+const MAX_RBI: usize = 8;
+const HANDSHAKE_TIMEOUT: Duration = Duration::from_secs(10);
+
+const USAGE: &str = "usage: crow-server --bind <ADDR:PORT> --token <SECRET|argon2:HEX> [--mode eco|rbi|tunnel|all] [--ram-only] [--chromium <PATH>]
+       crow-server --print-token-hash <SECRET>
+The token may also come from the CROW_TOKEN environment variable.";
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Mode {
+    Eco,
+    Rbi,
+    Tunnel,
+    All,
+}
+
+pub struct Config {
+    psk: Zeroizing<[u8; 32]>,
+    mode: Mode,
+    pub ram_only: bool,
+    pub chromium: Option<PathBuf>,
+    pub socks_port: u16,
+    pub rbi_slots: Semaphore,
+    pub http: reqwest::Client,
+}
+
+impl Config {
+    fn serves(&self, m: Mode) -> bool {
+        self.mode == Mode::All || self.mode == m
+    }
+}
+
+struct Args {
+    bind: String,
+    token: Zeroizing<String>,
+    mode: Mode,
+    ram_only: bool,
+    chromium: Option<PathBuf>,
+}
+
+fn parse_args() -> Result<Args, String> {
+    let mut it = std::env::args().skip(1);
+    let (mut bind, mut token, mut mode, mut ram_only, mut chromium) = (None, None, Mode::All, false, None);
+    while let Some(a) = it.next() {
+        let mut value = || it.next().ok_or_else(|| format!("{a} needs a value"));
+        match a.as_str() {
+            "--bind" => bind = Some(value()?),
+            "--token" => token = Some(Zeroizing::new(value()?)),
+            "--mode" => {
+                mode = match value()?.as_str() {
+                    "eco" => Mode::Eco,
+                    "rbi" => Mode::Rbi,
+                    "tunnel" => Mode::Tunnel,
+                    "all" => Mode::All,
+                    other => return Err(format!("unknown mode: {other}")),
+                };
+            }
+            "--ram-only" => ram_only = true,
+            "--chromium" => chromium = Some(PathBuf::from(value()?)),
+            "--print-token-hash" => {
+                let secret = Zeroizing::new(value()?);
+                let hex: String = derive_psk(&secret).iter().map(|b| format!("{b:02x}")).collect();
+                println!("argon2:{hex}");
+                std::process::exit(0);
+            }
+            other => return Err(format!("unknown argument: {other}")),
+        }
+    }
+    let token = token.or_else(|| std::env::var("CROW_TOKEN").ok().map(Zeroizing::new)).ok_or("--token is required")?;
+    Ok(Args { bind: bind.ok_or("--bind is required")?, token, mode, ram_only, chromium })
+}
+
+async fn shutdown_signal() {
+    #[cfg(unix)]
+    {
+        use tokio::signal::unix::{SignalKind, signal};
+        match signal(SignalKind::terminate()) {
+            Ok(mut term) => {
+                tokio::select! {
+                    _ = term.recv() => {}
+                    _ = tokio::signal::ctrl_c() => {}
+                }
+            }
+            Err(_) => {
+                let _ = tokio::signal::ctrl_c().await;
+            }
+        }
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = tokio::signal::ctrl_c().await;
+    }
+}
+
+async fn serve(stream: TcpStream, cfg: Arc<Config>) {
+    let _ = stream.set_nodelay(true);
+    let Ok(Ok((tx, mut rx))) = tokio::time::timeout(HANDSHAKE_TIMEOUT, accept(stream, &cfg.psk)).await else { return };
+    let Ok(Some(open)) = tokio::time::timeout(HANDSHAKE_TIMEOUT, rx.recv_json::<Open>()).await else { return };
+    dispatch(open, tx, rx, cfg).await;
+}
+
+async fn refuse<S>(mut tx: Tx<S>, code: &str)
+where
+    S: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin,
+{
+    let _ = tx.send_json(&Reply::Err { code: code.into() }).await;
+}
+
+async fn dispatch<S>(open: Open, mut tx: Tx<S>, rx: Rx<S>, cfg: Arc<Config>)
+where
+    S: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin,
+{
+    match &open {
+        Open::Ping => {
+            let _ = tx.send_json(&Reply::Ok).await;
+        }
+        Open::Eco { url } if cfg.serves(Mode::Eco) => eco::run(tx, url, &cfg.http).await,
+        Open::Rbi { url, width, height } if cfg.serves(Mode::Rbi) => {
+            if let Err(code) = rbi::run(&mut tx, rx, url, *width, *height, &cfg).await {
+                refuse(tx, code).await;
+            }
+        }
+        Open::Tunnel { host, port } if cfg.serves(Mode::Tunnel) => tunnel::run(tx, rx, host, *port).await,
+        _ => refuse(tx, "remote_err_mode").await,
+    }
+}
+
+#[tokio::main]
+async fn main() {
+    let args = match parse_args() {
+        Ok(a) => a,
+        Err(e) => {
+            eprintln!("{e}\n{USAGE}");
+            std::process::exit(2);
+        }
+    };
+    let fail = |msg: String| -> ! {
+        eprintln!("crow-server: {msg}");
+        std::process::exit(1);
+    };
+    let token = args.token;
+    let psk = match tokio::task::spawn_blocking(move || parse_token(&token)).await {
+        Ok(Ok(k)) => k,
+        Ok(Err(e)) => fail(e.to_string()),
+        Err(e) => fail(e.to_string()),
+    };
+
+    ram::sweep_stale();
+    if args.ram_only {
+        ram::harden();
+        if let (true, Some(problem)) = (args.mode == Mode::Rbi || args.mode == Mode::All, ram::ram_only_problem()) {
+            if args.mode == Mode::Rbi {
+                fail(format!("--ram-only: {problem}"));
+            }
+            eprintln!("warning: --ram-only: RBI sessions will be refused: {problem}");
+        }
+    }
+
+    let http = match eco::client() {
+        Ok(c) => c,
+        Err(e) => fail(e),
+    };
+    let socks_port = match tunnel::local_socks().await {
+        Ok(p) => p,
+        Err(e) => fail(e.to_string()),
+    };
+    let listener = match TcpListener::bind(&args.bind).await {
+        Ok(l) => l,
+        Err(e) => fail(format!("{}: {e}", args.bind)),
+    };
+    let cfg = Arc::new(Config {
+        psk,
+        mode: args.mode,
+        ram_only: args.ram_only,
+        chromium: args.chromium,
+        socks_port,
+        rbi_slots: Semaphore::new(MAX_RBI),
+        http,
+    });
+    let slots = Arc::new(Semaphore::new(MAX_CONNECTIONS));
+    eprintln!("crow-server listening on {}", args.bind);
+
+    let shutdown = shutdown_signal();
+    tokio::pin!(shutdown);
+    loop {
+        tokio::select! {
+            () = &mut shutdown => break,
+            r = listener.accept() => {
+                let Ok((stream, _)) = r else { continue };
+                let Ok(permit) = slots.clone().try_acquire_owned() else { continue };
+                let cfg = cfg.clone();
+                tokio::spawn(async move {
+                    serve(stream, cfg).await;
+                    drop(permit);
+                });
+            }
+        }
+    }
+    // Returning drops the runtime and with it every session task: their guards kill the browsers
+    // and wipe the session directories.
+}
diff --git a/crates/crow-server/src/policy.rs b/crates/crow-server/src/policy.rs
new file mode 100644
index 0000000..46365ac
--- /dev/null
+++ b/crates/crow-server/src/policy.rs
@@ -0,0 +1,140 @@
+//! What the node may reach, enforced for all three engines: no internal addresses (the node must
+//! not become a door into its own network), no tracker hosts, web ports only.
+
+use reqwest::dns::{Addrs, Name, Resolve, Resolving};
+use std::{
+    io::{self, ErrorKind},
+    net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr},
+    time::Duration,
+};
+use tokio::net::{TcpStream, lookup_host};
+use url::{Host, Url};
+
+const CONNECT_TIMEOUT: Duration = Duration::from_secs(10);
+
+/// Ad and telemetry domains, matched with their subdomains.
+const TRACKERS: &[&str] = &[
+    "2mdn.net", "adnxs.com", "adroll.com", "adsafeprotected.com", "adservice.google.com", "adsrvr.org",
+    "amazon-adsystem.com", "appsflyer.com", "bluekai.com", "branch.io", "casalemedia.com", "chartbeat.com",
+    "chartbeat.net", "clarity.ms", "criteo.com", "criteo.net", "demdex.net", "doubleclick.net", "everesttech.net",
+    "facebook.net", "fullstory.com", "google-analytics.com", "googleadservices.com", "googlesyndication.com",
+    "googletagmanager.com", "googletagservices.com", "hotjar.com", "krxd.net", "mixpanel.com", "moatads.com",
+    "mouseflow.com", "nr-data.net", "omtrdc.net", "openx.net", "outbrain.com", "pubmatic.com", "quantserve.com",
+    "rlcdn.com", "rubiconproject.com", "scorecardresearch.com", "segment.io", "taboola.com", "tiqcdn.com",
+    "yieldmo.com", "zedo.com",
+];
+
+fn v4_allowed(ip: Ipv4Addr) -> bool {
+    let [a, b, c, _] = ip.octets();
+    !(ip.is_unspecified()
+        || ip.is_loopback()
+        || ip.is_private()
+        || ip.is_link_local()
+        || ip.is_broadcast()
+        || ip.is_documentation()
+        || ip.is_multicast()
+        || a == 0
+        || a >= 240
+        || (a == 100 && (64..128).contains(&b))
+        || (a == 192 && b == 0 && c == 0)
+        || (a == 198 && (b == 18 || b == 19)))
+}
+
+fn v6_allowed(ip: Ipv6Addr) -> bool {
+    let s = ip.segments();
+    let embedded = |hi: u16, lo: u16| v4_allowed(Ipv4Addr::from((u32::from(hi) << 16) | u32::from(lo)));
+    if let Some(v4) = ip.to_ipv4_mapped() {
+        return v4_allowed(v4);
+    }
+    match s[0] {
+        // ::/96 (IPv4-compatible, loopback, unspecified) and the rest of 0000::/16.
+        0 => false,
+        0x64 if s[1] == 0xff9b => embedded(s[6], s[7]),
+        0x2002 => embedded(s[1], s[2]),
+        0x2001 if s[1] == 0xdb8 => false,
+        x if x & 0xfe00 == 0xfc00 || x & 0xffc0 == 0xfe80 || x & 0xff00 == 0xff00 => false,
+        _ => true,
+    }
+}
+
+pub fn ip_allowed(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v) => v4_allowed(v),
+        IpAddr::V6(v) => v6_allowed(v),
+    }
+}
+
+/// Web ports only: the node is no mail or SSH relay.
+pub fn port_allowed(port: u16) -> bool {
+    port == 80 || port == 443 || port >= 1024
+}
+
+pub fn tracker(host: &str) -> bool {
+    let h = host.trim_end_matches('.').to_ascii_lowercase();
+    TRACKERS.iter().any(|d| h == *d || h.strip_suffix(d).is_some_and(|r| r.ends_with('.')))
+}
+
+fn internal_name(host: &str) -> bool {
+    let h = host.trim_end_matches('.').to_ascii_lowercase();
+    !h.contains('.') || [".localhost", ".local", ".internal", ".intranet", ".lan"].iter().any(|s| h.ends_with(s))
+}
+
+/// http(s) address the node may fetch; DNS answers are checked separately (`Dns`, `connect`).
+pub fn check_url(u: &Url) -> Result<(), &'static str> {
+    if !matches!(u.scheme(), "http" | "https") || !port_allowed(u.port_or_known_default().unwrap_or(0)) {
+        return Err("remote_err_blocked");
+    }
+    let ok = match u.host() {
+        Some(Host::Domain(d)) => !tracker(d) && !internal_name(d),
+        Some(Host::Ipv4(ip)) => v4_allowed(ip),
+        Some(Host::Ipv6(ip)) => v6_allowed(ip),
+        None => false,
+    };
+    if ok { Ok(()) } else { Err("remote_err_blocked") }
+}
+
+/// Resolver for `reqwest`: internal answers are dropped, so a public name cannot point the node
+/// at its own network, not even after a redirect or a rebinding.
+pub struct Dns;
+
+impl Resolve for Dns {
+    fn resolve(&self, name: Name) -> Resolving {
+        Box::pin(async move {
+            let found = lookup_host((name.as_str(), 0)).await?;
+            let good: Vec<SocketAddr> = found.filter(|a| ip_allowed(a.ip())).collect();
+            if good.is_empty() {
+                return Err(Box::new(io::Error::from(ErrorKind::PermissionDenied)) as Box<dyn std::error::Error + Send + Sync>);
+            }
+            Ok(Box::new(good.into_iter()) as Addrs)
+        })
+    }
+}
+
+/// TCP to `host:port` through the policy. Connects to the very addresses that were checked.
+pub async fn connect(host: &str, port: u16) -> io::Result<TcpStream> {
+    let denied = || io::Error::from(ErrorKind::PermissionDenied);
+    let bare = host.trim_start_matches('[').trim_end_matches(']');
+    if !port_allowed(port) || bare.len() > 253 {
+        return Err(denied());
+    }
+    let addrs: Vec<SocketAddr> = if let Ok(ip) = bare.parse::<IpAddr>() {
+        vec![SocketAddr::new(ip, port)]
+    } else {
+        if tracker(bare) || internal_name(bare) {
+            return Err(denied());
+        }
+        lookup_host((bare, port)).await?.collect()
+    };
+    let mut last = denied();
+    for a in addrs.into_iter().filter(|a| ip_allowed(a.ip())) {
+        match tokio::time::timeout(CONNECT_TIMEOUT, TcpStream::connect(a)).await {
+            Ok(Ok(s)) => {
+                let _ = s.set_nodelay(true);
+                return Ok(s);
+            }
+            Ok(Err(e)) => last = e,
+            Err(_) => last = ErrorKind::TimedOut.into(),
+        }
+    }
+    Err(last)
+}
diff --git a/crates/crow-server/src/ram.rs b/crates/crow-server/src/ram.rs
new file mode 100644
index 0000000..e698c0f
--- /dev/null
+++ b/crates/crow-server/src/ram.rs
@@ -0,0 +1,179 @@
+//! Volatile session storage: browser profiles live on tmpfs and are overwritten and removed when
+//! the session ends.
+
+use std::{
+    fs, io,
+    path::{Path, PathBuf},
+    sync::atomic::{AtomicU64, Ordering},
+    time::Duration,
+};
+
+const PREFIX: &str = "crow-rbi-";
+
+#[cfg(target_os = "linux")]
+fn volatile(path: &Path) -> bool {
+    use std::{ffi::CString, os::unix::ffi::OsStrExt};
+    const TMPFS: i64 = 0x0102_1994;
+    const RAMFS: i64 = 0x8584_58f6;
+    let Ok(c) = CString::new(path.as_os_str().as_bytes()) else { return false };
+    let mut st: libc::statfs = unsafe { std::mem::zeroed() };
+    if unsafe { libc::statfs(c.as_ptr(), &raw mut st) } != 0 {
+        return false;
+    }
+    #[allow(clippy::useless_conversion, clippy::unnecessary_cast)]
+    let kind = st.f_type as i64;
+    kind == TMPFS || kind == RAMFS
+}
+
+#[cfg(target_os = "linux")]
+fn roots() -> Vec<PathBuf> {
+    let mut v = vec![PathBuf::from("/dev/shm")];
+    v.extend(std::env::var_os("XDG_RUNTIME_DIR").map(PathBuf::from));
+    v.retain(|p| volatile(p));
+    v
+}
+
+#[cfg(not(target_os = "linux"))]
+fn roots() -> Vec<PathBuf> {
+    Vec::new()
+}
+
+#[cfg(target_os = "linux")]
+fn swap_active() -> bool {
+    fs::read_to_string("/proc/swaps").map_or(true, |s| s.lines().count() > 1)
+}
+
+#[cfg(not(target_os = "linux"))]
+fn swap_active() -> bool {
+    true
+}
+
+/// Why `--ram-only` cannot be honoured for browser profiles on this machine.
+pub fn ram_only_problem() -> Option<&'static str> {
+    if roots().is_empty() {
+        Some("no tmpfs mount available (/dev/shm, $XDG_RUNTIME_DIR)")
+    } else if swap_active() {
+        Some("swap is active, tmpfs pages could reach the disk (swapoff -a)")
+    } else {
+        None
+    }
+}
+
+/// `--ram-only` process hardening: no core dumps, no ptrace by other users, memory locked when
+/// the limit allows it (otherwise locking would make later allocations fail).
+#[cfg(unix)]
+pub fn harden() {
+    unsafe {
+        let none = libc::rlimit { rlim_cur: 0, rlim_max: 0 };
+        libc::setrlimit(libc::RLIMIT_CORE, &raw const none);
+        #[cfg(target_os = "linux")]
+        libc::prctl(libc::PR_SET_DUMPABLE, 0);
+        let mut lim: libc::rlimit = std::mem::zeroed();
+        if libc::getrlimit(libc::RLIMIT_MEMLOCK, &raw mut lim) == 0
+            && lim.rlim_cur == libc::RLIM_INFINITY
+            && libc::mlockall(libc::MCL_CURRENT | libc::MCL_FUTURE) != 0
+        {
+            eprintln!("warning: mlockall failed");
+        }
+    }
+}
+
+#[cfg(not(unix))]
+pub fn harden() {}
+
+fn unique_name() -> String {
+    static NEXT: AtomicU64 = AtomicU64::new(0);
+    format!("{PREFIX}{:x}-{:x}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed))
+}
+
+fn make_private(path: &Path) -> io::Result<()> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        fs::DirBuilder::new().mode(0o700).create(path)
+    }
+    #[cfg(not(unix))]
+    {
+        fs::create_dir(path)
+    }
+}
+
+fn zero_file(path: &Path) -> io::Result<()> {
+    use std::io::Write;
+    let len = fs::symlink_metadata(path)?.len();
+    let mut f = fs::OpenOptions::new().write(true).open(path)?;
+    let zeros = [0u8; 64 * 1024];
+    let mut left = len;
+    while left > 0 {
+        let n = usize::try_from(left.min(zeros.len() as u64)).unwrap_or(zeros.len());
+        f.write_all(&zeros[..n])?;
+        left -= n as u64;
+    }
+    f.sync_all()
+}
+
+/// Zeros every regular file below `dir`. Links are not followed.
+fn scrub(dir: &Path) {
+    let Ok(entries) = fs::read_dir(dir) else { return };
+    for e in entries.flatten() {
+        let Ok(t) = e.file_type() else { continue };
+        if t.is_dir() {
+            scrub(&e.path());
+        } else if t.is_file() {
+            let _ = zero_file(&e.path());
+        }
+    }
+}
+
+fn wipe(dir: &Path) {
+    // Windows keeps files locked for a moment after the browser's processes are gone.
+    for _ in 0..20 {
+        scrub(dir);
+        if fs::remove_dir_all(dir).is_ok() || !dir.exists() {
+            return;
+        }
+        std::thread::sleep(Duration::from_millis(150));
+    }
+    eprintln!("warning: a session directory could not be removed");
+}
+
+/// Directories left by a run that was killed before it could clean up.
+pub fn sweep_stale() {
+    let mut places = roots();
+    places.push(std::env::temp_dir());
+    for root in places {
+        let Ok(entries) = fs::read_dir(&root) else { continue };
+        for e in entries.flatten() {
+            if e.file_name().to_string_lossy().starts_with(PREFIX) && e.file_type().is_ok_and(|t| t.is_dir()) {
+                wipe(&e.path());
+            }
+        }
+    }
+}
+
+/// A session's directory; wiped on drop.
+pub struct RamDir(PathBuf);
+
+impl RamDir {
+    /// On tmpfs when there is one. Without it only a run without `--ram-only` falls back to the
+    /// temp directory.
+    pub fn create(ram_only: bool) -> Result<Self, &'static str> {
+        if ram_only && ram_only_problem().is_some() {
+            return Err("remote_err_ram");
+        }
+        let root = roots().into_iter().next().unwrap_or_else(std::env::temp_dir);
+        let path = root.join(unique_name());
+        make_private(&path).map_err(|_| "remote_err_rbi")?;
+        Ok(Self(path))
+    }
+
+    pub fn path(&self) -> &Path {
+        &self.0
+    }
+}
+
+impl Drop for RamDir {
+    fn drop(&mut self) {
+        wipe(&self.0);
+    }
+}
